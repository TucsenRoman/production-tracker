@import url("https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;450;500;600;700&display=swap");
@import "tailwindcss";

/* =============================================================================
   Design tokens
   -----------------------------------------------------------------------------
   One primary action colour (ink-blue), one brand colour (rust, used for the
   wordmark and nothing else), and four semantic states. Surfaces are a warm
   neutral scale rather than a flat cream wash, so elevation actually reads.
   Anything declared unlayered would outrank every Tailwind utility, so this
   file stays: tokens, a small base layer, and named utilities.
   ========================================================================== */

@theme {
  /* ---- Surfaces (back to front) ---- */
  --color-canvas: #f6f5f3;
  --color-sunken: #f0eeea;
  --color-surface: #ffffff;
  --color-raised: #ffffff;

  /* ---- Lines ---- */
  --color-line: #e6e3dd;
  --color-line-strong: #d4cfc6;

  /* ---- Ink (text) ---- */
  --color-ink: #1b1917;
  --color-ink-2: #57514a;
  --color-ink-3: #8a837a;
  --color-ink-4: #aaa298;

  /* ---- Primary action ---- */
  --color-primary: #1e3a5f;
  --color-primary-hover: #162c49;
  --color-primary-soft: #eaeff5;
  --color-primary-ink: #24486f;

  /* ---- Brand (wordmark, accents) ---- */
  --color-brand: #9a3f2c;
  --color-brand-soft: #f8ebe6;

  /* ---- Semantic states ---- */
  --color-ok: #3d7a49;
  --color-ok-soft: #e8f0e8;
  --color-ok-line: #c4dcc7;

  --color-warn: #a67611;
  --color-warn-soft: #fbf2df;
  --color-warn-line: #ecd9a8;

  --color-danger: #b0402c;
  --color-danger-soft: #fbeae5;
  --color-danger-line: #f0cec3;

  --color-cold: #2f79a6;
  --color-cold-soft: #e8f1f7;

  /* ---- Type ---- */
  --font-sans:
    "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-display: "Fraunces", Georgia, "Times New Roman", serif;
  --font-mono: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, monospace;

  /* ---- Elevation ---- */
  --shadow-xs: 0 1px 2px rgb(27 25 23 / 0.05);
  --shadow-sm: 0 1px 3px rgb(27 25 23 / 0.07), 0 1px 2px rgb(27 25 23 / 0.04);
  --shadow-md: 0 4px 12px -2px rgb(27 25 23 / 0.09), 0 2px 4px rgb(27 25 23 / 0.04);
  --shadow-lg: 0 16px 32px -12px rgb(27 25 23 / 0.18), 0 4px 8px rgb(27 25 23 / 0.05);
  --shadow-pop: 0 24px 48px -16px rgb(27 25 23 / 0.28);

  /* ---- Radii ---- */
  --radius-sm: 5px;
  --radius-md: 7px;
  --radius-lg: 10px;
  --radius-xl: 14px;
}

@layer base {
  html {
    scrollbar-gutter: stable;
  }

  html,
  body {
    max-width: 100vw;
    overflow-x: hidden;
  }

  body {
    min-height: 100vh;
    min-height: 100dvh; /* mobile browser chrome collapses on scroll */
    background: var(--color-canvas);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-feature-settings: "cv05", "ss01";
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  input,
  button,
  select,
  textarea {
    font-family: inherit;
    color: inherit;
  }

  /* Every number in this product is meant to be compared down a column. */
  .tnum,
  input[type="number"] {
    font-variant-numeric: tabular-nums;
  }

  /* One focus treatment everywhere, keyboard-only. */
  :focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  ::selection {
    background: var(--color-primary-soft);
  }

  /* ---- Phones ---- */
  @media (max-width: 639px) {
    /* iOS zooms the page whenever a focused field is under 16px. */
    input[type="text"],
    input[type="number"],
    input[type="password"],
    input:not([type]),
    select,
    textarea {
      font-size: 16px;
    }
  }

  /* ---- Touch devices: station tablets, phones on the floor ---- */
  @media (hover: none) and (pointer: coarse) {
    button,
    [role="button"] {
      -webkit-tap-highlight-color: transparent;
      -webkit-user-select: none;
      user-select: none;
      touch-action: manipulation;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
}

/* =============================================================================
   Named utilities
   ========================================================================== */

/* Clears the iPhone home indicator under fixed bottom chrome. */
@utility pb-safe {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

@utility pt-safe {
  padding-top: env(safe-area-inset-top, 0px);
}

/* Swipe is the affordance on touch; the bar is just noise. */
@utility no-scrollbar {
  scrollbar-width: none;
  -ms-overflow-style: none;
  &::-webkit-scrollbar {
    display: none;
  }
}

/* Desktop scrollers keep a slim, low-contrast bar. */
@utility thin-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: var(--color-line-strong) transparent;
}

@utility tnum {
  font-variant-numeric: tabular-nums;
}

/* =============================================================================
   Motion
   ========================================================================== */

@keyframes ui-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes ui-pop-in {
  from {
    opacity: 0;
    transform: translateY(6px) scale(0.985);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ui-slide-up {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ui-toast-in {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.97);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes ui-shimmer {
  from {
    background-position: 200% 0;
  }
  to {
    background-position: -200% 0;
  }
}

@utility animate-fade-in {
  animation: ui-fade-in 0.14s ease-out both;
}

@utility animate-pop-in {
  animation: ui-pop-in 0.16s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

@utility animate-slide-up {
  animation: ui-slide-up 0.2s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

@utility animate-toast-in {
  animation: ui-toast-in 0.18s cubic-bezier(0.2, 0.8, 0.3, 1) both;
}

@utility skeleton {
  background-image: linear-gradient(
    90deg,
    var(--color-sunken) 25%,
    var(--color-line) 37%,
    var(--color-sunken) 63%
  );
  background-size: 200% 100%;
  animation: ui-shimmer 1.4s ease-in-out infinite;
}
